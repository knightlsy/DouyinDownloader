<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标前景层：下箭头 + 底横线。

  语义：箭头本身是「下载」，底横线是「落到盘上」。
  两笔合成一个符号，比旧版「播放三角 + 右下小箭头」更直接 ——
  旧版要读两个形状才明白「下载视频」，且右下小箭头在 32px 以下会糊成一点。

  几何：
    · 竖线   x=54, y=30 → 62
    · 箭头   (40,52) → (54,66) → (68,52)
    · 底横线 x=36 → 72, y=82

  为什么用 butt 而不是 round 线帽：
    这是 A（Cinema）那套「精密仪器」的语言 —— 方头切线干净，
    在 24px 上边缘不会因为抗锯齿变圆而显得糊。旧版用的是 round。

  安全区：
    图形最远点 (72,82)，距中心 (54,54) 半径为 30.5，
    落在自适应图标 66dp 安全圆（半径 33）内。圆形/方圆/方形遮罩下都不会被切。

  小尺寸适配：
    底横线在 24px 下会和箭头粘成一团，所以它在视觉上做得很轻
    （strokeWidth 8 vs 箭头的 11），即便糊掉也不影响主体识别。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 箭身 -->
    <path
        android:pathData="M54,30 L54,62"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="butt" />

    <!-- 箭头（M 形折线） -->
    <path
        android:pathData="M40,52 L54,66 L68,52"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="11"
        android:strokeLineCap="butt"
        android:strokeLineJoin="miter" />

    <!-- 落盘横线 -->
    <path
        android:pathData="M36,82 L72,82"
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="butt" />
</vector>
